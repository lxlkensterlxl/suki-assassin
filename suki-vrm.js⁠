import * as THREE from 'https://esm.sh/three@0.169.0';
import { GLTFLoader } from 'https://esm.sh/three@0.169.0/examples/jsm/loaders/GLTFLoader.js';
import { VRMLoaderPlugin, VRMUtils } from 'https://esm.sh/@pixiv/three-vrm@3.1.5';

export class SukiVRMController {
  constructor(container) {
    if (!container) {
      throw new Error('SukiVRMController requires a valid container element.');
    }

    this.container = container;
    this.vrm = null;
    this.clock = new THREE.Clock();
    this.isSpeaking = false;
    this.blinkTimer = 0;
    this.nextBlink = 2.5;
    this._rafId = null;
    this._disposed = false;

    const width = Math.max(1, container.clientWidth);
    const height = Math.max(1, container.clientHeight);

    // Scene & Transparent Renderer (overlays cleanly on cyberpunk HUD)
    this.scene = new THREE.Scene();
    this.camera = new THREE.PerspectiveCamera(28, width / height, 0.1, 20);
    this.camera.position.set(0, 1.38, 1.55);
    this.camera.lookAt(0, 1.28, 0);

    this.renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    this.renderer.setSize(width, height);
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    this.renderer.outputColorSpace = THREE.SRGBColorSpace;
    container.appendChild(this.renderer.domElement);

    // Cyberpunk rim + soft front lighting
    const keyLight = new THREE.DirectionalLight(0xffffff, 1.6);
    keyLight.position.set(1, 2, 2);
    this.scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0xd946ef, 1.1); // Neon fuchsia rim
    rimLight.position.set(-1.5, 1.8, -1.5);
    this.scene.add(rimLight);

    this.scene.add(new THREE.AmbientLight(0xffffff, 0.75));

    this._handleResize = this.onResize.bind(this);
    window.addEventListener('resize', this._handleResize);

    this.animate = this.animate.bind(this);
    this._rafId = requestAnimationFrame(this.animate);
  }

  _disposeCurrentVrm() {
    if (!this.vrm) return;
    this.scene.remove(this.vrm.scene);
    VRMUtils.deepDispose(this.vrm.scene);
    this.vrm = null;
  }

  async load(url = './models/suki.vrm') {
    if (this._disposed) return null;

    const loader = new GLTFLoader();
    loader.register((parser) => new VRMLoaderPlugin(parser));

    return new Promise((resolve, reject) => {
      loader.load(
        url,
        (gltf) => {
          if (this._disposed) return;

          const vrm = gltf.userData.vrm;
          if (!vrm) {
            reject(new Error(`Loaded asset at "${url}" is not a valid VRM model.`));
            return;
          }

          VRMUtils.removeUnnecessaryVertices(gltf.scene);
          VRMUtils.removeUnnecessaryJoints(gltf.scene);

          // VRM 3.x rotateVRM0 expects vrm.scene
          VRMUtils.rotateVRM0(vrm.scene);

          // Relaxed A-pose adjustment (verify signs against your specific model's rest pose)
          const leftArm = vrm.humanoid?.getNormalizedBoneNode('leftUpperArm');
          const rightArm = vrm.humanoid?.getNormalizedBoneNode('rightUpperArm');
          if (leftArm) leftArm.rotation.z = 0.85;
          if (rightArm) rightArm.rotation.z = -0.85;

          this._disposeCurrentVrm();
          this.vrm = vrm;
          this.scene.add(vrm.scene);
          vrm.update(0);

          resolve(vrm);
        },
        undefined,
        (err) => reject(err)
      );
    });
  }

  // Trigger VRM 1.0 / 0.x mapped expressions: 'happy', 'angry', 'sad', 'relaxed', 'surprised', 'neutral'
  setExpression(name, weight = 1.0) {
    const manager = this.vrm?.expressionManager;
    if (!manager) return;

    const presets = ['happy', 'angry', 'sad', 'relaxed', 'surprised', 'neutral'];
    presets.forEach((p) => manager.setValue(p, 0));

    if (name && name !== 'neutral') {
      manager.setValue(name, weight);
    }
  }

  // Hook directly into SpeechSynthesisUtterance lifecycle events
  bindSpeechUtterance(utterance) {
    if (!utterance) return;

    const stopSpeaking = () => {
      this.isSpeaking = false;
      this.vrm?.expressionManager?.setValue('aa', 0);
    };

    utterance.addEventListener('start', () => {
      this.isSpeaking = true;
    });
    utterance.addEventListener('end', stopSpeaking);
    utterance.addEventListener('error', stopSpeaking);
  }

  stopSpeaking() {
    this.isSpeaking = false;
    this.vrm?.expressionManager?.setValue('aa', 0);
  }

  onResize() {
    if (!this.container || this._disposed) return;
    const w = Math.max(1, this.container.clientWidth);
    const h = Math.max(1, this.container.clientHeight);
    this.camera.aspect = w / h;
    this.camera.updateProjectionMatrix();
    this.renderer.setSize(w, h);
  }

  animate() {
    if (this._disposed) return;
    this._rafId = requestAnimationFrame(this.animate);

    // Clamp delta to prevent large jumps after backgrounding/tab switch
    const delta = Math.min(this.clock.getDelta(), 0.05);
    const elapsed = this.clock.elapsedTime;

    if (this.vrm) {
      // Subtle idle breathing & head sway
      const chest = this.vrm.humanoid?.getNormalizedBoneNode('chest');
      const head = this.vrm.humanoid?.getNormalizedBoneNode('head');
      if (chest) chest.rotation.x = Math.sin(elapsed * 2.0) * 0.025;
      if (head) {
        head.rotation.y = Math.sin(elapsed * 0.9) * 0.06;
        head.rotation.z = Math.cos(elapsed * 0.7) * 0.02;
      }

      const expressions = this.vrm.expressionManager;

      // Natural auto-blink
      this.blinkTimer += delta;
      if (this.blinkTimer >= this.nextBlink) {
        const blinkPhase = (this.blinkTimer - this.nextBlink) / 0.14;
        if (blinkPhase <= 1.0) {
          expressions?.setValue('blink', Math.sin(blinkPhase * Math.PI));
        } else {
          expressions?.setValue('blink', 0);
          this.blinkTimer = 0;
          this.nextBlink = 2.0 + Math.random() * 3.5;
        }
      }

      // Simple vowel mouth movement while TTS is active
      if (this.isSpeaking) {
        const mouthOpen = (Math.sin(elapsed * 18) + 1) * 0.4;
        expressions?.setValue('aa', mouthOpen);
      }

      this.vrm.update(delta);
    }

    this.renderer.render(this.scene, this.camera);
  }

  dispose() {
    this._disposed = true;
    if (this._rafId !== null) {
      cancelAnimationFrame(this._rafId);
      this._rafId = null;
    }
    window.removeEventListener('resize', this._handleResize);
    this._disposeCurrentVrm();
    this.renderer.dispose();
    if (this.renderer.domElement.parentNode === this.container) {
      this.container.removeChild(this.renderer.domElement);
    }
  }
}
